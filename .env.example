# Copia este archivo como ".env" y cambia los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Dominio público. En tu computador déjalo como "localhost".
# En el servidor pon tu dominio real, por ejemplo: eventos.duckdns.org
DOMAIN=localhost

DB_NAME=unitropico_eventos
DB_USER=unitropico
DB_PASS=cambia_esta_clave
DB_ROOT_PASS=cambia_esta_clave_root
